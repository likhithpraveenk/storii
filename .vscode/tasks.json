{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dart fix",
      "type": "shell",
      "command": "dart fix --apply",
      "problemMatcher": []
    },
    {
      "label": "dart format",
      "type": "shell",
      "command": "dart format .",
      "problemMatcher": []
    },
    {
      "label": "codegen build",
      "type": "shell",
      "command": "dart run build_runner build --force-aot",
      "problemMatcher": "$dart-build_runner"
    },
    {
      "label": "codegen watch",
      "type": "shell",
      "command": "dart run build_runner watch --force-aot",
      "presentation": {
        "revealProblems": "onProblem",
        "reveal": "silent",
        "clear": true,
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": "$dart-build_runner"
    },
    {
      "label": "abs_api codegen build",
      "type": "shell",
      "command": "dart run build_runner build --force-aot",
      "problemMatcher": "$dart-build_runner",
      "options": {
        "cwd": "${workspaceFolder}/packages/abs_api"
      },
    },
    {
      "label": "abs_api codegen watch",
      "type": "shell",
      "command": "dart run build_runner watch --force-aot",
      "presentation": {
        "revealProblems": "onProblem",
        "reveal": "silent",
        "clear": true,
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": "$dart-build_runner",
      "options": {
        "cwd": "${workspaceFolder}/packages/abs_api"
      },
    }
  ]
}